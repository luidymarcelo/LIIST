LIIST_SUPABASE_URL=https://seu-projeto.supabase.co
LIIST_SUPABASE_ANON_KEY=sua-chave-anon
LIIST_PRINT_AGENT_TOKEN=liist_pat_token_gerado_no_supabase
LIIST_PRINT_OUTPUT_DIR=print-outbox
LIIST_PRINT_INTERVAL_SECONDS=4
LIIST_PRINTER_NAME=Nome exato da impressora

# Opcional: comando executado depois que o arquivo da comanda for gerado.
# Use {file} como marcador do arquivo e {printer} como marcador da impressora.
# Windows exemplo:
# LIIST_PRINT_COMMAND=powershell -NoProfile -Command Start-Process -FilePath "$env:WINDIR\System32\notepad.exe" -ArgumentList "/pt","{file}","{printer}" -Wait -WindowStyle Hidden
